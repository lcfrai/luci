+	t.Cleanup(func() { pd.Close() })
+	env := sessionsNewEnvOverWith(t, root, store, store, func(d *Deps) {
+		d.Product, d.ProjectsDir = pd, options.ProjectsDir
+		d.ResourceSnapshot = executionFixtureSnapshot
+		d.ReadyTimeout = 5 * time.Second
