FROM __BASE_IMAGE_ID__ AS build
WORKDIR /build
COPY calculator.mjs calculator.test.mjs server.mjs build.mjs fixture-manifest.json ./
RUN node --test --test-reporter=tap calculator.test.mjs > test-output.tap && node build.mjs
FROM __BASE_IMAGE_ID__
WORKDIR /app
COPY --from=build /build/dist/ /app/
USER 65532:65532
EXPOSE 3000
CMD ["node", "server.mjs"]
