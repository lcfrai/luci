{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      },
      "maxItems": 128
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "string",
            "maxLength": 2000
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "decision",
          "rationale"
        ]
      },
      "maxItems": 8
    },
    "reportedChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "maxLength": 2000
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not-run",
              "unknown"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "command",
          "outcome",
          "detail"
        ]
      },
      "maxItems": 16
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000
          },
          "impact": {
            "type": "string",
            "maxLength": 2000
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "question",
          "impact",
          "blocking"
        ]
      },
      "maxItems": 8
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "maxItems": 16
    },
    "addressedMessages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "discovery",
              "question",
              "dependency-result",
              "review-finding",
              "decision",
              "lifecycle-request"
            ]
          },
          "recipientTaskId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "causalMessageId": {
            "type": "string",
            "maxLength": 128
          },
          "summary": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "kind",
          "recipientTaskId",
          "causalMessageId",
          "summary"
        ]
      },
      "maxItems": 8
    }
  },
  "required": [
    "version",
    "summary",
    "changedFiles",
    "decisions",
    "reportedChecks",
    "questions",
    "limitations",
    "addressedMessages"
  ]
}
