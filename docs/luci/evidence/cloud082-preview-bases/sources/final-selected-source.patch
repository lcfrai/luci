+type previewBasePullBody struct {
+	io.Reader
+	readError, closeError error
+	onEOF                 func()
+	closed                int
+}
+
+func (r *previewBasePullBody) Read(data []byte) (int, error) {
+	n, err := r.Reader.Read(data)
+	if err == io.EOF {
+		if r.onEOF != nil {
+			r.onEOF()
+		}
+		if r.readError != nil {
+			return n, r.readError
+		}
+	}
+	return n, err
+}
+
+func (r *previewBasePullBody) Close() error {
+	r.closed++
+	return r.closeError
+}
