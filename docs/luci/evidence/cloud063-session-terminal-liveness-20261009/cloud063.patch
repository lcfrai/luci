+func TestRelayUpstreamExitHookDiscriminatesDirectionAndType(t *testing.T) {
+	var mu sync.Mutex
+	var upstreamSizes, clientSizes []int
+	var exits, sizesBeforeExit int
+	client, peer, ctx := exitHookRelay(t, proxy.Hooks{
