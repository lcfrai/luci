# One dedicated, already-bound Luci team installation. Render only the four
# documented placeholders; never pass this whole file through bare envsubst.
# Both upstream ports must remain private loopback/firewall destinations.
worker_processes auto;
pid /tmp/luci-ingress.pid;
error_log /var/log/nginx/luci-error.log warn;
events { worker_connections 1024; }
http {
  # Requests contain one-use browser invitations. Disable access logs rather
  # than persisting their query strings, data tokens or application paths.
  access_log off;
  server_tokens off;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
  }
  server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${LUCI_APP_HOST};
    ssl_certificate ${LUCI_TLS_CERTIFICATE};
    ssl_certificate_key ${LUCI_TLS_PRIVATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 512m;
    location / {
      proxy_pass http://127.0.0.1:8730;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Forwarded "";
      proxy_set_header X-Forwarded-Host "";
      proxy_set_header X-Forwarded-Proto "";
      proxy_set_header X-Forwarded-For "";
      proxy_read_timeout 86400s;
      proxy_send_timeout 300s;
      proxy_buffering off;
    }
  }
  server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name *.${LUCI_PREVIEW_BASE_DOMAIN};
    ssl_certificate ${LUCI_TLS_CERTIFICATE};
    ssl_certificate_key ${LUCI_TLS_PRIVATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 512m;
    location / {
      proxy_pass http://127.0.0.1:8731;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Forwarded "";
      proxy_set_header X-Forwarded-Host "";
      proxy_set_header X-Forwarded-Proto "";
      proxy_set_header X-Forwarded-For "";
      proxy_read_timeout 86400s;
      proxy_send_timeout 300s;
      proxy_buffering off;
    }
  }
}
