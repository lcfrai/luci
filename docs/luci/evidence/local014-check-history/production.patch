+// Unknown evidence is not necessarily unresolved execution: source changes or
+// unavailable output can leave a safely cleaned run unknown. Only explicit
+// resource release and exact cleanup receipts make such a row evictable; legacy
+// or partial ownership remains pinned regardless of its diagnostic message.
+func checkHistoryNeedsExecution(row ProjectCheckRun) bool {
+	if row.Status == "queued" || row.Status == "running" || row.ResourcesHeld != nil && *row.ResourcesHeld {
+		return true
+	}
+	if row.Status != "unknown" {
+		return false
+	}
+	if row.Revision < 1 || row.ResourcesHeld == nil || len(row.Commands) == 0 {
+		return true
+	}
+	for _, command := range row.Commands {
+		if command.Status == "skipped" {
+			continue
+		}
+		if command.AllocationID == "" || !command.CleanupConfirmed {
+			return true
+		}
+		switch command.Status {
+		case "passed", "failed", "blocked", "unknown", "cancelled":
+		default:
+			return true
+		}
+	}
+	return false
+}
