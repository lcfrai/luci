{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PanaceaApp platform chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespaces", "network", "sandboxes", "storage", "warm"],
  "definitions": {
    "cidr": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
    },
    "quantity": {
      "type": "string",
      "minLength": 1
    }
  },
  "properties": {
    "namespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hub", "broker", "sandboxes", "edge", "identity"],
      "properties": {
        "hub": {"type": "string", "minLength": 1},
        "broker": {"type": "string", "minLength": 1},
        "sandboxes": {"type": "string", "minLength": 1},
        "edge": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vnetCidr", "podCidr", "serviceCidr", "privateEndpointsCidr"],
      "properties": {
        "vnetCidr": {"$ref": "#/definitions/cidr"},
        "podCidr": {"$ref": "#/definitions/cidr"},
        "serviceCidr": {"$ref": "#/definitions/cidr"},
        "privateEndpointsCidr": {"$ref": "#/definitions/cidr"}
      }
    },
    "sandboxes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeClass", "quota", "limitRange"],
      "properties": {
        "runtimeClass": {"type": "string", "minLength": 1},
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestsCpu", "requestsMemory", "pods", "persistentVolumeClaims", "requestsStorage"],
          "properties": {
            "requestsCpu": {"$ref": "#/definitions/quantity"},
            "requestsMemory": {"$ref": "#/definitions/quantity"},
            "pods": {"$ref": "#/definitions/quantity"},
            "persistentVolumeClaims": {"$ref": "#/definitions/quantity"},
            "requestsStorage": {"$ref": "#/definitions/quantity"}
          }
        },
        "limitRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxCpu", "maxMemory", "defaultCpu", "defaultMemory"],
          "properties": {
            "maxCpu": {"$ref": "#/definitions/quantity"},
            "maxMemory": {"$ref": "#/definitions/quantity"},
            "defaultCpu": {"$ref": "#/definitions/quantity"},
            "defaultMemory": {"$ref": "#/definitions/quantity"}
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machineDisk", "nfsFallback"],
      "properties": {
        "machineDisk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "skuName"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "skuName": {"enum": ["Premium_LRS", "Premium_ZRS", "StandardSSD_ZRS"]}
          }
        },
        "nfsFallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "name"],
          "properties": {
            "enabled": {"type": "boolean"},
            "name": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "warm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  }
}
