+		{"stdout-discriminant", websocket.MessageBinary, []byte{0x00, 0x03}},
+		{"stdout-lookalike", websocket.MessageBinary, []byte("\x00exit status 0\n[session ended]")},
+		{"other-binary-kind", websocket.MessageBinary, []byte{0x02, 0x03}},
+	} {
