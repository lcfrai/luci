+test('known SDK check query guard rejects raw fragments before URL parsing or forwarding',async t=>{
+  const f=await fixture(t,recoveryOptions,(entry,res,reply)=>{
+    if(entry.method==='GET'&&entry.path.includes('/stats?'))return json(res,200,{});
+    reply(entry,res);
+  });
+  const id=await createCheck(f,labelsFor('a')),before=f.received.length,secret='controlled-fragment-sentinel';
+  for(const prefix of [api,'/containers/'])for(const suffix of ['#'+secret,'#','%23'+secret]){
+    const path=prefix+id+'/stats?one-shot=1&stream=0'+suffix;
+    assert.equal((await f.request('GET',path).promise).status,503);
+    const row=f.proxy.observations.requests.at(-1);assert.equal(row.failure,'check-query-shape-refused');assert.equal(row.checkStatsQuery,undefined);
+  }
+  for(const [method,suffix] of [['GET','/json?#'+secret],['GET','/logs?stdout=1&stderr=1&tail=all#'+secret],['POST','/start?#'+secret],['DELETE','?v=1#'+secret]]){
+    assert.equal((await f.request(method,api+id+suffix).promise).status,503);assert.equal(f.proxy.observations.requests.at(-1).failure,'check-query-shape-refused');
+  }
