{
  "name": "@lcfr/luci-desktop",
  "description": "Luci — define, design, develop and deploy in one place.",
  "homepage": "https://lcfr.ai",
  "private": true,
  "version": "0.4.18",
  "license": "MIT",
  "type": "module",
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.19",
      "sass": "1.105.1"
    },
