{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcfr.ai/schemas/runtime-oci-pull-manifest-v2.schema.json",
  "title": "Luci installed compressed runtime pull manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "sourceCommit", "target", "canonicalInputAlgorithm", "canonicalInputDigest", "sourceFiles", "runtime", "image", "registryStore", "bootstrap", "licenses", "producer"],
  "properties": {
    "version": {"const": 2},
    "kind": {"const": "luci-runtime-registry-pull"},
    "sourceCommit": {"$ref": "#/$defs/commit"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {"os": {"const": "linux"}, "architecture": {"const": "amd64"}}
    },
    "canonicalInputAlgorithm": {"const": "luci-git-blobs-v1"},
    "canonicalInputDigest": {"$ref": "#/$defs/hash"},
    "sourceFiles": {
      "type": "array", "minItems": 2, "maxItems": 8192,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "mode", "sha256", "bytes"],
        "properties": {
          "path": {"$ref": "#/$defs/path"}, "mode": {"const": "0644"},
          "sha256": {"$ref": "#/$defs/hash"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}
        }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["user", "workingDir", "entrypoint", "exposedPorts", "harnesses"],
      "properties": {
        "user": {"const": "dev"},
        "workingDir": {"const": "/home/dev"},
        "entrypoint": {"const": ["/usr/local/bin/entrypoint.sh"]},
        "exposedPorts": {"const": ["8080/tcp"]},
        "harnesses": {
          "type": "object", "additionalProperties": false,
          "required": ["codex", "claudeCode", "openCode"],
          "properties": {
            "codex": {"const": "0.160.0"},
            "claudeCode": {"const": "2.1.274"},
            "openCode": {"const": "1.18.34"}
          }
        }
      }
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "configSHA256", "configBytes", "manifestDigest", "manifestMediaType", "layers"],
      "properties": {
        "id": {"$ref": "#/$defs/imageID"},
        "configSHA256": {"$ref": "#/$defs/hash"},
        "configBytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "manifestDigest": {"$ref": "#/$defs/imageID"},
        "manifestMediaType": {"const": "application/vnd.docker.distribution.manifest.v2+json"},
        "layers": {
          "type": "array", "minItems": 1, "maxItems": 2048,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["compressedDigest", "compressedBytes", "diffID", "uncompressedBytes", "mediaType"],
            "properties": {
              "compressedDigest": {"$ref": "#/$defs/imageID"},
              "compressedBytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
              "diffID": {"$ref": "#/$defs/imageID"},
              "uncompressedBytes": {"type": "integer", "minimum": 1, "maximum": 8589934592},
              "mediaType": {"const": "application/vnd.docker.image.rootfs.diff.tar.gzip"}
            }
          }
        }
      }
    },
    "registryStore": {
      "type": "object", "additionalProperties": false,
      "required": ["fileName", "sha256", "bytes", "repository", "members"],
      "properties": {
        "fileName": {"const": "runtime-registry-store-v2.tar"},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 1024, "maximum": 4294967296},
        "repository": {"const": "luci/runtime-installed"},
        "members": {
          "type": "array", "minItems": 4, "maxItems": 4096,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 20, "maxLength": 512, "pattern": "^docker/registry/v2/[A-Za-z0-9._/-]+$"},
              "sha256": {"$ref": "#/$defs/hash"},
              "bytes": {"type": "integer", "minimum": 1, "maximum": 4294967296}
            }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object", "additionalProperties": false,
      "required": ["fileName", "sha256", "bytes", "imageID", "configSHA256", "diffIDs", "entrypoint", "distributionVersion", "distributionArchiveSHA256", "distributionBinarySHA256", "gateSourceSHA256", "gateBinarySHA256", "buildReceiptSHA256"],
      "properties": {
        "fileName": {"const": "runtime-registry-bootstrap-linux-amd64.tar"},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 1024, "maximum": 268435456},
        "imageID": {"$ref": "#/$defs/imageID"},
        "configSHA256": {"$ref": "#/$defs/hash"},
        "diffIDs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/imageID"}},
        "entrypoint": {"const": ["/luci-registry-gate"]},
        "distributionVersion": {"const": "3.0.0"},
        "distributionArchiveSHA256": {"const": "61c9a2c0d5981a78482025b6b69728521fbc78506d68b223d4a2eb825de5ca3d"},
        "distributionBinarySHA256": {"$ref": "#/$defs/hash"},
        "gateSourceSHA256": {"$ref": "#/$defs/hash"},
        "gateBinarySHA256": {"$ref": "#/$defs/hash"},
        "buildReceiptSHA256": {"$ref": "#/$defs/hash"}
      }
    },
    "licenses": {
      "type": "array", "minItems": 2, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "component", "version", "grant", "provenance"],
        "properties": {
          "path": {"type": "string", "maxLength": 256, "pattern": "^licenses/runtime-(image|bootstrap)/[A-Za-z0-9._/-]+$"},
          "sha256": {"$ref": "#/$defs/hash"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
          "component": {"type": "string", "minLength": 1, "maxLength": 160},
          "version": {"type": "string", "minLength": 1, "maxLength": 80},
          "grant": {"type": "string", "minLength": 1, "maxLength": 160},
          "provenance": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["originalBuildReceiptSHA256", "conversionReceiptSHA256", "pullProducerReceiptSHA256"],
      "properties": {
        "originalBuildReceiptSHA256": {"$ref": "#/$defs/hash"},
        "conversionReceiptSHA256": {"$ref": "#/$defs/hash"},
        "pullProducerReceiptSHA256": {"$ref": "#/$defs/hash"},
        "reuseEvidenceSHA256": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "imageID": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._/-]+$"}
  }
}
