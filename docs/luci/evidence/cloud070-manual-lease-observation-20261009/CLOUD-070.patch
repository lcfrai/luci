+package backend
+
+import "context"
+
+// AllocationAbsenceObserver is an optional read-only maintenance capability.
+// True proves both the reusable logical name and the recorded immutable object
+// are absent. Present, foreign, renamed, removing, or uncertain objects cannot
+// be projected as absence. The caller fences concurrent allocation and checks
+// the same settled registry generation and capacity receipt before retirement.
+// Backends without this proof retain the existing on-demand release behavior.
+type AllocationAbsenceObserver interface {
+	AllocationAbsent(ctx context.Context, id, immutableRef string) (bool, error)
+}
--- a/control-plane/internal/backend/dockerbe/allocation_observation.go
+++ b/control-plane/internal/backend/dockerbe/allocation_observation.go
@@ -0,0 +1,41 @@
+package dockerbe
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/lcfrai/luci/control-plane/internal/backend"
+)
+
+var _ backend.AllocationAbsenceObserver = (*Backend)(nil)
+
+// AllocationAbsent performs no ownership filtering: even a foreign object at
+// the logical name retains the old charge. An original container renamed away
+// from that name is still present at its immutable reference and also retains.
+func (b *Backend) AllocationAbsent(ctx context.Context, id, immutableRef string) (bool, error) {
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	if !fenceLogicalID(id) || !fenceHex(immutableRef, 32) {
+		return false, backend.ErrUnsupported
+	}
+	if _, creating := b.creates.Load(id); creating {
+		return false, nil
+	}
+	for _, target := range []string{namePrefix + id, immutableRef} {
+		_, err := b.api.ContainerInspect(ctx, target)
+		if ctx.Err() != nil {
+			return false, ctx.Err()
+		}
+		if err == nil {
+			return false, nil
+		}
+		if !stoppedCleanupNotFound(err) {
+			return false, fmt.Errorf("dockerbe: exact allocation absence is unconfirmed: %w", backend.ErrUnavailable)
+		}
+	}
+	if _, creating := b.creates.Load(id); creating {
+		return false, nil
+	}
+	return true, nil
+}
