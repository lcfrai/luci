# LF on every checkout for OpenTofu, HCL, scripts, YAML and templates (phase 8 task 01).
# Windows git's core.autocrlf=true would otherwise write CRLF into the working tree, and a
# CRLF shell script fails under bash (`$'\r': command not found`), on the laptop or wherever
# the working tree is copied (an image build context, for one). The index is LF either way.
*.tf          text eol=lf
*.tfvars      text eol=lf
*.hcl         text eol=lf
*.tftest.hcl  text eol=lf
*.sh          text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.tpl         text eol=lf
# Task 28: the pipeline scripts' fixtures are compared byte for byte (.expect, .extends, .remove
# and Chart.lock have no extension above), and the scanners' own config.
pipelines/scripts/testdata/** text eol=lf
Chart.lock    text eol=lf
*.toml        text eol=lf
