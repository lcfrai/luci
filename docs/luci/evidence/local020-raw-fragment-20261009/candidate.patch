+  assert.equal((await f.request('DELETE',api+id+'?v=1').promise).status,204);
+  const marker=JSON.parse((await f.request('POST',createPath(labels),{Labels:fenceLabelsFor(labels)}).promise).body).Id;
+  for(const ref of [worker,marker,'f'.repeat(64)])for(const prefix of [api,'/containers/'])for(const method of ['GET','HEAD']){
+    const path=prefix+ref+'/stats?one-shot=1&stream=0#controlled-generic-fragment',before=f.received.length;
+    assert.equal((await f.request(method,path).promise).status,method==='GET'?200:204);assert.equal(f.received.length,before+1);
+    assert.equal(f.received.at(-1).path,path);assert.equal(f.proxy.observations.requests.at(-1).checkStatsQuery,undefined);
+  }
+  assert.deepEqual(f.proxy.observations.failures,[]);assert.equal(f.proxy.observations.counts.start,0);
+});
