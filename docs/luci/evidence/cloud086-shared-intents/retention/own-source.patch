+	for _, row := range origins.Turns {
+		if row.ID != turn.ID {
+			kept = append(kept, row)
+		}
+	}
+	origins.Turns = kept
+	if err = s.saveOrchestrator(origins); err != nil {
+		t.Fatal(err)
+	}
+	current, err := s.OrchestratorView(ctx, p.ID, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.OriginTurnID = turn.ID
+	req.ExpectedContextDigest = current.Context.Digest
+	req.Run.ImplementationContext.PlanRevision = current.Context.Plan.Revision
+	// Archive readback does not waive current source admission. Applying the
+	// amendment changed the exported plan, so this first preparation must keep
+	// the real dirty-source refusal and must not dispatch an upstream task.
+	if !current.Context.SourceKnown || !current.Context.SourceDirty {
