{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcfr.ai/schemas/runtime-oci-build-receipt-v1.schema.json",
  "title": "Luci producer-only runtime OCI build receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "buildSourceCommit",
    "canonicalInputAlgorithm",
    "canonicalInputDigest",
    "target",
    "generatedContextSHA256",
    "baseImages",
    "builder",
    "imageID",
    "archive",
    "probes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "luci-runtime-producer-build"
    },
    "buildSourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "canonicalInputAlgorithm": {
      "const": "luci-git-blobs-v1"
    },
    "canonicalInputDigest": {
      "$ref": "#/$defs/digest"
    },
    "target": {
      "const": {
        "os": "linux",
        "architecture": "amd64"
      }
    },
    "generatedContextSHA256": {
      "$ref": "#/$defs/digest"
    },
    "baseImages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "imageID",
          "repoDigest"
        ],
        "properties": {
          "reference": {
            "enum": [
              "golang:1.26-bookworm",
              "node:24-bookworm-slim"
            ]
          },
          "imageID": {
            "$ref": "#/$defs/imageID"
          },
          "repoDigest": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+@sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "version",
        "argv",
        "memoryBytes",
        "cpuQuotaMicros",
        "exitCode",
        "stdoutSHA256",
        "stderrSHA256",
        "cacheAssistance",
        "cacheAssistanceLogSHA256"
      ],
      "properties": {
        "backend": {
          "const": "docker-builder-v1"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "argv": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 0
        },
        "cpuQuotaMicros": {
          "type": "integer",
          "minimum": 0
        },
        "exitCode": {
          "const": 0
        },
        "stdoutSHA256": {
          "$ref": "#/$defs/digest"
        },
        "stderrSHA256": {
          "$ref": "#/$defs/digest"
        },
        "cacheAssistance": {
          "type": "boolean"
        },
        "cacheAssistanceLogSHA256": {
          "$ref": "#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cacheAssistance": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "cacheAssistanceLogSHA256": {
                "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
              }
            }
          }
        }
      ]
    },
    "imageID": {
      "$ref": "#/$defs/imageID"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 8589934592
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "argv",
          "exitCode",
          "reportedVersion",
          "stdoutSHA256",
          "stderrSHA256"
        ],
        "properties": {
          "tool": {
            "enum": [
              "sandboxd",
              "codex",
              "claudeCode",
              "openCode"
            ]
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "exitCode": {
            "const": 0
          },
          "reportedVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "stdoutSHA256": {
            "$ref": "#/$defs/digest"
          },
          "stderrSHA256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imageID": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
