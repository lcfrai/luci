+  const departed = pending.get('p1')!;
+  expect(screen.getByRole('button', { name: 'Open project Notes' })).toBeTruthy();
+  act(() => useCockpit.getState().setProjects([projects[1]]));
+  view.rerender(<ProjectOverviewBoard projects={[projects[1]]} />);
